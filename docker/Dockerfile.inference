# Inference image for nuxnet-inference, built on the training image so the
# architecture and the torch build are identical to what produced the checkpoint.
#
# The training image carries torch, tifffile, networkx, click and rich but not
# scikit-image, which the nuclei instance post-processing needs for measure.label.
# Installing it here keeps the training image untouched and reproducible.
FROM nuxnet-training:local

RUN python -m pip install --no-cache-dir "scikit-image==0.24.0" "scipy==1.13.1"

WORKDIR /work
ENV PYTHONPATH=/work
CMD ["python", "-c", "import skimage, torch; print('inference image ready', torch.__version__)"]
